{
  "name": "flowix",
  "private": true,
  "version": "1.3.6",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-web-bundle.mjs",
    "clean": "rm -rf .build dist app/target app/flowix-desktop/binaries",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path app/Cargo.toml --workspace --lib",
    "check:layers": "node scripts/check-layer-boundaries.mjs",
    "check:package-manager": "node scripts/check-package-manager.mjs",
    "check:frontend-debt": "node scripts/check-frontend-debt.mjs",
    "check:web-bundle": "node scripts/check-web-bundle.mjs",
    "preview": "vite preview",
    "cli:build:dev": "node scripts/build-cli.mjs --debug",
    "cli:build:prod": "node scripts/build-cli.mjs",
    "cli:build:prod:macos": "node scripts/build-cli.mjs --macos",
    "dsh:build:dev": "node scripts/build-dsh-dev-local.mjs",
    "dsh:build:prod": "node scripts/build-dsh-prod.mjs",
    "dsh:build:prod:macos": "node scripts/build-dsh-macos-prod.mjs",
    "dsh:build:prod:windows": "node scripts/build-dsh-windows-prod.mjs",
    "dsh:package:prod": "node scripts/package-dsh-prod.mjs",
    "dsh:package:prod:windows": "node scripts/package-dsh-windows-prod.mjs",
    "dsh:package:local": "node scripts/package-dsh-local.mjs",
    "dsh:publish": "node scripts/publish-dsh-release.mjs",
    "test:dsh:packaging": "node --test scripts/dsh-native-deps.test.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs app/flowix-desktop/tauri.conf.dev.json",
    "tauri:dev:win": "node scripts/tauri-dev.mjs app/flowix-desktop/tauri.windows.dev.conf.json",
    "tauri:build:prod": "node scripts/build-tauri-production.mjs",
    "release:updater": "bash scripts/release.sh",
    "verify:flowix-package": "node scripts/verify-flowix-package.mjs",
    "icons:phosphor:bold": "node scripts/extract-phosphor-bold-paths.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-list": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/markdown": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "date-fns": "^4.1.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.33.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "pinyin-pro": "^3.28.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "svg-pan-zoom": "^3.6.2",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/svg-pan-zoom": "^3.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@yao-pkg/pkg": "6.21.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "shadcn": "^4.7.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.9"
  }
}
